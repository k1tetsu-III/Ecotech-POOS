# Base de datos local predeterminada
DB_ENGINE=sqlite
DB_NAME=ecotech.db

# Para MySQL, configura estos valores en tu .env local
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Necesarias para crear las cuentas de demostración con src/semilla_bd.py
# Usa contraseñas propias de al menos 6 y máximo 72 bytes UTF-8.
ECOTECH_SEED_ADMIN_PASSWORD=
ECOTECH_SEED_EMPLOYEE_PASSWORD=
