# Copia este archivo como ".env" y ajusta los valores. El archivo .env NO se publica.

# Motor de base de datos: sqlite o mysql
DB_ENGINE=sqlite

# --- SQLite (valor por defecto) ---
# Nombre del archivo que se crea en la carpeta desde donde ejecutas el programa
DB_NAME=ecotech.db

# --- MySQL 
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecotech
DB_USER=ecotech_app
DB_PASSWORD=3.12
